# Copy to .env (git-ignored) and fill in. Never commit real values.
# DATABASE_URL=postgresql://user@localhost/platerelay
# PLATERELAY_SECRET=

# Object storage: local (default) or oss for Aliyun OSS / any S3-compatible service.
PLATERELAY_STORAGE=local
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# Optional: address browsers use for signed links, signing region, path-style addressing (MinIO)
# OSS_PUBLIC_ENDPOINT=
# OSS_REGION=oss-cn-beijing
# OSS_PATH_STYLE=1
