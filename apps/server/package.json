{
  "name": "@platerelay/server",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Tom_Chicken",
    "email": "Tom_Chicken@qq.com"
  },
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "pnpm --filter @platerelay/shared build && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "pnpm build && node --watch-path=dist dist/src/main.js",
    "test": "pnpm build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@platerelay/shared": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "fflate": "0.8.3",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
  }
}
